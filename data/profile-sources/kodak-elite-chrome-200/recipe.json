  "film": {
    "id": "kodak_elite_chrome_200",
    "name": "*Kodak ELITE Chrome 200",
    "type": "positive",
    "densitometer": "status_A",
    "base_density": 0.1,
    "base_density_note": "Not on the sheet. The dye panel is normalised to a visual neutral of 1.0 and plots no D-min, and the characteristic minimum is a status-A reading, not a spectral curve. A flat 0.10 is assumed, within the 0.09-0.13 range the shipped positives carry. Assumption, not a measurement.",
    "channel_dmin_note": "Per-channel minima are read off the characteristic curves and subtracted before unmixing, so the fitted dye amounts reach zero at full exposure.",
    "midgray_net_density": null,
    "sensitivity_note": "PCHIP of the three plotted log-sensitivity traces; engine covers 380-780 nm, each trace is used only over its own plotted span and is unmeasured elsewhere. Relative shape only; the panel criterion is not an absolute speed.",
    "density_tolerance": 0.02,
    "density_tolerance_note": "Gate on the unmixed dye amounts, not plotted density. 0.02 dye-amount units is about 0.8% of the 2.5-2.8 unit range used for the sibling Ektachrome preparations.",
    "midgray_total_density": 0.735182,
    "midgray_note": "Rendering convention: engine log exposure zero is placed where the green channel's total status-A density equals -log10(0.184), the 18.4% reference grey this repository uses elsewhere. Not absolute ISO metering.",
    "antihalation": "strong",
    "antihalation_note": "Not stated on the sheet. Taken from shipped kodak_ektachrome_100, the nearest E-6 sibling, rather than guessed; it drives the halation preset only.",
    "log_sensitivity_density_over_min": 1.0,
    "reference_illuminant": "D55"
  },
  "print": {
    "target_print": null,
    "note": "A reversal film: scanned directly, no print stage."
  },
  "sampling": {
    "log_exposure_min": -3.0,
    "log_exposure_max": 4.0,
    "count": 256,
    "method": "Constrained positive normal-CDF mixture, four components per channel, fitted on mirrored log exposure because the engine evaluates a positive's model with a negated argument."
